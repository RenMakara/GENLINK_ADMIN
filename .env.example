# GenLink KH Admin — environment configuration
#
# Copy to `.env.local` (git-ignored) and adjust. Every value is validated at startup by
# lib/config/env.ts, which is the only file in the app allowed to read process.env — see
# SSOT §1.7. A malformed value fails the build with a message naming the variable.
#
# The values below are the MVP deployment (SSOT §12.1): the portal and the API behind one
# nginx origin on a bare IP. Nothing here names a host, which is what makes moving to
# https://admin.genlink.kh a configuration change and not a code change.

# ── Client (inlined into the browser bundle — nothing secret) ────────────────

# Relative keeps the portal and the API on one origin, so CORS does not apply at all.
# Becomes e.g. https://api.genlink.kh/api/v1 when they are split across subdomains.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Path the portal is served under. Empty once it has its own subdomain.
NEXT_PUBLIC_BASE_PATH=/admin

# Display timezone. Fixed, not the browser's: two admins comparing a dashboard have to be
# looking at the same day boundary (SSOT §9.5).
NEXT_PUBLIC_TIMEZONE=Asia/Phnom_Penh

# ── Server only ─────────────────────────────────────────────────────────────

# `Secure` flag on the refresh-token cookie. Defaults to true; the MVP runs over plain HTTP
# behind an SSH tunnel (SSOT §10.9.1), where a Secure cookie would simply never be sent.
#
# Set this back to true the moment TLS is in place. It is deliberately the unsafe direction
# that needs an explicit opt-in.
ADMIN_COOKIE_SECURE=false
