# GenLink KH Admin — environment configuration

# ── Client (inlined into the browser bundle — nothing secret) ────────────────

# Becomes e.g. https://api.genlink.kh/api/v1 when they are split across subdomains.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_BASE_PATH=/admin
NEXT_PUBLIC_TIMEZONE=Asia/Phnom_Penh
NEXT_PUBLIC_API_MOCKING=false

# ── Server only ─────────────────────────────────────────────────────────────
ADMIN_COOKIE_SECURE=false
NEXT_PUBLIC_ENVIRONMENT=development
ADMIN_API_ORIGIN=http://localhost:8888


