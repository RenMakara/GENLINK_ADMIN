# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It contains no secrets and is how a new developer learns
# which variables exist; ignored by the line above without this exception.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── IDE / editor ──────────────────────────────────────────────────────────
# NOT optional. The backend repo tracked .idea/workspace.xml and it carried
# MAIL_PASSWORD, JWT_SECRET, DB_* and GOOGLE_* in plaintext; untracking does
# not remove them from history (docs/PROJECT_STATUS.md). Getting this right
# in the first commit is the only cheap moment.
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
Thumbs.db

# local tooling output
/playwright-report/
/test-results/

.vercel
